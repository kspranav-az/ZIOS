# InterviewOS — local dev/test environment (copy to .env; never commit .env)

# Postgres
POSTGRES_USER=interviewos
POSTGRES_PASSWORD=interviewos_dev
POSTGRES_DB=interviewos
POSTGRES_PORT=5432
DATABASE_URL=postgresql://interviewos:interviewos_dev@localhost:5432/interviewos

# Redis
REDIS_PORT=6379
REDIS_URL=redis://localhost:6379

# API service (NestJS) — host port mapped to container :3000
API_PORT=3000

# AI orchestrator (FastAPI) — host port mapped to container :8000
ORCHESTRATOR_PORT=8000

# MinIO (S3-compatible)
MINIO_ROOT_USER=minioadmin
MINIO_ROOT_PASSWORD=minioadmin_dev
MINIO_API_PORT=9000
MINIO_CONSOLE_PORT=9001
MINIO_BUCKET_MEDIA=interviewos-media
MINIO_BUCKET_ARTIFACTS=interviewos-artifacts
MINIO_BUCKET_REPORTS=interviewos-reports
S3_ENDPOINT=http://localhost:9000

# Mailpit (dev SMTP + web UI at http://localhost:8025)
MAILPIT_SMTP_PORT=1025
MAILPIT_UI_PORT=8025
SMTP_URL=smtp://localhost:1025

# api: email + auth (Phase 01). EMAIL_ADAPTER selects the EmailSender binding
# (ADR-0002); 'mailpit' is the only adapter until a real provider's phase.
EMAIL_ADAPTER=mailpit
MAIL_FROM=InterviewOS <no-reply@interviewos.local>
WEB_BASE_URL=http://localhost:5173
CORS_ORIGIN=http://localhost:5173,http://localhost:5174
# Set to true when serving over HTTPS so the session cookie gets Secure.
COOKIE_SECURE=false

# Optional: set to the parent domain (e.g., hapkonic.com) when the API and SPAs
# run on sibling subdomains, so the session cookie is shared across them.
# COOKIE_DOMAIN=

# LiveKit (dev-mode keys; real project credentials only in Phase 07+)
LIVEKIT_PORT=7880
LIVEKIT_API_KEY=devkey
LIVEKIT_API_SECRET=secret
LIVEKIT_URL=ws://localhost:7880

# employer-web SPA (host port mapped to container :80)
EMPLOYER_WEB_PORT=5173

# candidate-web SPA (host port mapped to container :80)
CANDIDATE_WEB_PORT=5174

# ---------------------------------------------------------------------------
# Optional network/LAN mode
# ---------------------------------------------------------------------------
# To expose the stack on the LAN (e.g., via Pranav-Mac-Air.local), create a
# second env file with overrides and load it after .env:
#   docker compose --env-file .env --env-file network.env up -d --build
#
# Variables the stack uses in network mode:
# WEB_BASE_URL=http://Pranav-Mac-Air.local:5173
# CORS_ORIGIN=http://Pranav-Mac-Air.local:5173,http://Pranav-Mac-Air.local:5174
# VITE_API_URL=http://Pranav-Mac-Air.local:3000
# VITE_ORCHESTRATOR_URL=ws://Pranav-Mac-Air.local:8000
# LIVEKIT_URL=ws://Pranav-Mac-Air.local:7880
# LIVEKIT_NODE_IP=192.168.31.154
# EMPLOYER_WEB_BASE_URL=http://Pranav-Mac-Air.local:5173
# CANDIDATE_WEB_BASE_URL=http://Pranav-Mac-Air.local:5174

# Optional Cloudflare Tunnel mode
# ---------------------------------------------------------------------------
# For public HTTPS URLs without opening ports, see cloudflare.env.template.
# Cloudflare Tunnel proxies HTTP/WebSocket (apps, API, LiveKit signalling)
# but cannot proxy LiveKit media UDP; video/audio still needs direct UDP
# reachability (port forwarding) or a TURN server.

# api: kit preview tokens (Phase 02). Signs the 30-minute preview-as-candidate
# links; the code ships a local-dev default, so set this in any real deployment.
PREVIEW_TOKEN_SECRET=interviewos-local-preview-secret

# LLM provider configuration (Phase 06 real adapter wiring)
# LLM_MODE=mock  (default, deterministic fixtures, no API calls)
# LLM_MODE=gemini (uses Google Gemini for JD analysis, conductor, judge)
LLM_MODE=mock
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.5-flash-lite
