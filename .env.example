# InterviewOS — local dev/test environment (copy to .env; never commit .env)

# Postgres
POSTGRES_USER=interviewos
POSTGRES_PASSWORD=interviewos_dev
POSTGRES_DB=interviewos
POSTGRES_PORT=5432
DATABASE_URL=postgresql://interviewos:interviewos_dev@localhost:5432/interviewos

# Redis
REDIS_PORT=6379
REDIS_URL=redis://localhost:6379

# MinIO (S3-compatible)
MINIO_ROOT_USER=minioadmin
MINIO_ROOT_PASSWORD=minioadmin_dev
MINIO_API_PORT=9000
MINIO_CONSOLE_PORT=9001
MINIO_BUCKET_MEDIA=interviewos-media
MINIO_BUCKET_ARTIFACTS=interviewos-artifacts
MINIO_BUCKET_REPORTS=interviewos-reports
S3_ENDPOINT=http://localhost:9000

# Mailpit (dev SMTP + web UI at http://localhost:8025)
MAILPIT_SMTP_PORT=1025
MAILPIT_UI_PORT=8025
SMTP_URL=smtp://localhost:1025

# LiveKit (dev-mode keys; real project credentials only in Phase 07+)
LIVEKIT_PORT=7880
LIVEKIT_API_KEY=devkey
LIVEKIT_API_SECRET=secret
LIVEKIT_URL=ws://localhost:7880
